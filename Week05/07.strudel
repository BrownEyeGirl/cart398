// hyperpop beat 2.0? 
let s1 = 16; 
let s2 = 16; 
let brek = 2; 


let speedin = slider(4, 0, 8, 2)

// heartbeat
//$: s("[~ [x]]").fast(speedin).sound("compurhythm8000_hh")

$: arrange(
  [s1, "x x"], 
  [s2, "x"], 
  [brek, "~"]
).sound("bd").fast(speedin).lpf(300)//.gain(0.2).dist(3) 



// melody 
$: arrange(
  [s1, "<[[x x] x*6]/2>*4".note("D D# F G")], 
  [s2, "x".note("<G F D# D>")]
).sound("sawtooth*4")
  .gain(0.6)
  .delay(0.2)
  .room(0.4)
  .gain(0.5)
  .cutoff(sine.range(500, 4000).slow(4))
  .color("blue").scope() // vis


$: note("<[G6 G6] [D6 D6] [D#6 [D#6 D#6]] [F6 [G6 G#6]]>*4")
  //.transpose(-12) // one octave down
  .sound('gm_lead_6_voice')
  .crush(5)//perlin.range(5, 7))
  .gain(1)
  .lpf(1000)
  .someCycles(x=>x.rev()) // randomness and personality
  .color("violet")._pianoroll()

