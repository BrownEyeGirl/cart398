$: sound("wow").slow(12).cut(12).room(0.4).lpf(500).gain(0.8).speed(1.111).mask(time.gt(10)).delay(0.3)
$: sound("baby").slow(8).cut(8).room(0.4).gain(0.9).room(0.2).delay(0.2).speed(0.9).mask(time.gt(2))
