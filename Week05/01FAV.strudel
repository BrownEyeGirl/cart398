// hyperpop beat 2.0? 
let s1 = 8; 
let s2 = 8; 
let brek = 2; 

samples('github:BrownEyeGirl/sounds-strudel');


let speedin = slider(1, 0.8, 1.5) //in experimental phases still

$: s("monologue").slow(10).cut(10).speed(speedin).delay(0.2).room(0.1).cutoff(sine.range(500, 4000).slow(4)).pan(sine.range(-1, 1))

$: arrange(
  [brek, "~"], 
  [s1, "x x x [x x]"], 
  [s2, "x*4"], 
  [brek, "~"]
).sound("bd").fast(speedin).lpf(300).speed(speedin)

  

$: arrange(
  [brek, "~ x"], 
  [s1, "~ x ~ x"], 
  [s2, "x*4"], 
  [brek, "~"]
).sound("dpm48_perc").gain(0.3).delay(0.444)



// melody 
$: arrange(
  [brek, "~"], 
  [s1, "<[[x x?] x*6]/2>*4".note("D D# F G")], 
  [s2, "x".note("<G F D# D>")]
).sound("gm_pad_metallic*4")
  .gain(2)
  .delay(0.2)
  .room(0.4)
  .gain(0.4)
  .someCycles(x=>x.rev())
  .cutoff(sine.range(500, 4000).slow(4)).speed(speedin)
  .color("blue").scope()


$: arrange(
  [brek, "<[G6 G6] [D6 D6] [D#6 [D#6 D#6]] [F6 [G6 G#6]]>*4"],
  [s1, "<[G6 G6] [D6 D6] [D#6 [D#6 D#6]] [F6 [G6 G#6]]>*4".gain(0.5).someCycles(x=>x.rev())],
  [s2, "<[G6 G6] [D6 D6] [D#6 [D#6 D#6]] [F6 [G6 G#6]]>*4".someCycles(x=>x.rev()).gain(0.4)], 
).note().speed(speedin)
  //.transpose(-12) // one octave down
  .sound('gm_pad_halo')
  .lpf(1000)
  .color("violet")._pianoroll()

//$: note("[G5 ~] [A5 ~] [G5 F5] [D5 Eb5 F5]").sound('piano').transpose(-24)

