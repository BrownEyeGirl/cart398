// heartbeat

//heartbeat 
//$: s("clap(5, 16)").gain(0.5)
//$: s("bd [~ sd]").dist(1.3).gain(0.5)

setcpm(160/4)

samples({
  beep: 'https://cdn.freesound.org/previews/668/668978_14100561-lq.mp3',
  ascend: 'https://cdn.freesound.org/previews/128/128062_1019270-lq.mp3',
})


// heartbeat
$: s("<bd [bd ~] ~>*4").lpf(300).gain(0.8)

$: s("bd*8").gain(0.01).dist(1.4).lpf(400).mask(time.lt(7))
// beep
$: s("[ ~ beep]*2").begin(0.95).mask(time.lt(4))
$: s("~ [beep]*16").begin(0.95).mask(time.gt(4)).mask(time.lt(6))
$: s("<[~ beep ~ ~](<5 7 7 5>, 16)>*4").begin(0.748).end(1).mask(time.gt(6))
 // .loopAt(2) // fit sample into 2 cycles
  .color("blue").scope()

$: s("ascend").gain(0.2).mask(time.gt(5)).mask(time.lt(9))
$: s("ascend").gain(0.2).mask(time.gt(9)).slice(9, "8").cut(0.5)
