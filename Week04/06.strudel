// hyperpop beat? 

let speedin = slider(4, 0, 8, 2)

// heartbeat
$: s("[[bd] ~]").fast(speedin).lpf(300).gain(0.2).dist(3)
$: s("[~ [x]]").fast(speedin).sound("compurhythm8000_hh")

$: note("[G6 G6] [D6 D6] [D#6 D#6 D#6] [F6 G6 G#6]")
  //.transpose(-12) // one octave down
  .sound('piano')
  //.crush(perlin.range(5, 7))
  .gain(1)
  .lpf(1000)
  .someCycles(x=>x.rev()) // randomness and personality
  .color("violet")._pianoroll()
$: s("sawtooth").note("<D D# F G>").gain(0.6).delay(0.2)
  .transpose(-12)
  .gain(0.5)
  .lpf(1600)
.color("blue").scope()

