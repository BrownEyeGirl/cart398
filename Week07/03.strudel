// skyla

// layered melody 
 $: s("gm_celesta(9, 16)").legato(1.5).delay(2).n("<7, 9 5 2 1><1!3 8>").someCyclesBy(.3, x=>x.rev())
//.scale("C:major:pentatonic")//.note("a b c")
 .penv("4 -4 2 -2").vib("2:.2")// penv stands for pitch envelope..
.room(sine.range(0, 2)).size(2).gain(sine.range(0.2, 0.3))
.phaser(2)
   .dist(0.3)
//.cutoff(perlin.range(300, 2000))
.pcurve("<1 0.5 0>")
//.degradeBy(0.8)
.orbit(3)
//.crush(4)






