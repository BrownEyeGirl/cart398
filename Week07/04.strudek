// clars patch 
//hello its me clarence

samples('github:jcpros/samples')

samples({amen: 'https://cdn.freesound.org/previews/260/260050_450294-lq.mp3'})

// glitch click
$: note("[[8|8] [70|2] 100?0.5 [39*3]]*2").sound("user").partials([1,0])
  .hpf(3000)
  .noise(0.5).adsr("0:0.01:0:0")
  .often(x=>x.ply(2).dist(0.6).orbit(2).delaytime(0.01).delay(0.8).dfb(0.6).pan(rand.range(0.3,0.8)))
  .gain(0.8)
  //.degradeBy(0.5)

//celli vox
$: sound("vox:2").chop(10)
  //.speed(0.7)
  .sometimes(x=>x.speed(2).pan(rand.range(0.2,0.8)))
  .gain(0.5)
  .fast(1)
  .degradeBy(0.8)
  .ply(2)
  .speed(-1)


//bass
$: note("[30][20]?0.2[35*0][~ [~ 31]]").sound("user").partials([1,0,0,]).adsr("0:0.5:0:0")
  .fmh(2).fm(2).fmdecay(0.3)
  .distorttype("chebyshev").dist(2).distortvol(0.7)
  //.struct("x*2 ~ ")
  //.duckorbit(3).duckdepth(0.9).duckattack(0.2)
  .echo(2,1/4, 0.4)
  .gain(0.1)
