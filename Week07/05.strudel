$: "[c2 c3]*4".transpose("<0 -2 5 3>").note().sound("gm_distortion_guitar")
  .delay(0.2).room(1).size(2)
  //.duckorbit()
.gain(sine.range(0.5, 1).slow(2))


$: arrange(
  [4, "x*8".gain(0.4)],
  [4, "x".beat("0,4,8,11,14" ,16)], 
  [2, "~"]
).s("bd").cutoff(1000).dist(0.3).gain(0.7).legato(0.6)


$: s("[~ hh]*4(11, 16)").gain(0.2)
$: s("[~ hh]*4").delay(0.5).gain(0.2)
