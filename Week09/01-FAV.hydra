

await loadScript("https://cdn.jsdelivr.net/gh/geikha/hyper-hydra@latest/hydra-text.js")
await loadScript("https://hyper-hydra.glitch.me/hydra-text.js")

bpm = 86; 

hydraText.font = "cursive"
hydraText.lineWidth = "1.3%"
//hydraText.fontSize = "1em"
str = "goosebumps_"

voronoi([1, 4, 8, 10, 20], 1, 20)
    .modulatePixelate(noise(3, 0, 0.4))
 .layer(text(str).modulate(osc(), 0.001).color(0.4+time*0.0009, 0, 0.2+time*0.007))
	.out()







