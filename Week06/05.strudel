// MAPPIN THE BEAT 
let intro = 2
let verse = 4
let prec = 4
let chorus = 0


$: arrange(
  [intro, "~"], 
  [verse, "<[x x x [x x]] [x x x [x]*4]>"]
).sound("bd").room(0.3).cutoff(500).dist(0.9)



$: sound("wt_digital_echoes(6, 16)").note("<f <g d> e d c>").speed("<0.4 0.8 1.5 0.5 1.4>")


$: arrange(
  [intro, "<x:1 x:2 x:3 [x:4]*4>*4".delay(0.3)], 
  [verse, " ~ x? ~ ~".gain(0.5)]
  
  ).s("gm_guitar_fret_noise").gain(0.5)



