// alien noises kind of 

// MAPPIN THE BEAT 
let intro = 2
let verse = 4
let prec = 4
let chorus = 0
let transition = 1

// SAMPLES
samples({
  lithuanian: 'https://cdn.freesound.org/previews/565/565694_7495013-lq.mp3'
})

// 
let tone = "<C F E>/8:pentatonic"
let pulse = s("ace_bd").gain(2).velocity("0.5 0.3")//.release("<0 .1 .4 .6 1>/2")

let signals = n("<2, 0 5 2 1>*<2!3 4>(8,16)")
.scale(tone)
.s("gm_drawbar_organ")
.penv("<-4 9 3 -2>*2").vib("3:.3") // penv stands for pitch envelope.. 
.pattack("0 .3 0.2 .1").release(0.8) // to hear the pitch release
.phaser(2).delay(.222).room(.333).size(3) // echo / phasing
.pcurve("<0 1>")

let shakeitoff = s("shaker_small*4").gain(perlin.range(1, 2))


$: arrange(
  [intro, shakeitoff], 
  [verse, stack(pulse, shakeitoff, signals)],
  [prec, stack(pulse.s("x [x x] x [x x]"), shakeitoff, signals)],
  [chorus, "~"]
)

$: s("lithuanian").chop(1).speed(rand.range(0.85,1.1)).room(0.5).size(3).slow(4).delay(0.4).gain(sine.range(0, 1)).clip("<.5 1 2>").scope()



$: s("gm_fx_soundtrack").n("<5 2 1 3>/2").scale(tone).gain(0.5)
