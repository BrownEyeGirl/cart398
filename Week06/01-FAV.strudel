// alien noises kind of 

// MAPPIN THE BEAT 
let intro = 4
let verse = 4
let prec = 4
let chorus = 4
let transition = 1

// SAMPLES
samples({
  lithuanian: 'https://cdn.freesound.org/previews/565/565694_7495013-lq.mp3', 
  bot: 'https://cdn.freesound.org/previews/26/26462_186469-lq.mp3'
})

// 
let tone = "<C F E>/8:pentatonic"
let pulse = sound("ace_bd").gain(1)//.velocity("0.5 0.3")//.release("<0 .1 .4 .6 1>/2")

let signals = n("<2, 0 5 2 1>*<2!3 4>(8,16)")
.scale(tone)
.s("gm_drawbar_organ")
.penv("<-4 9 3 -2>*2").vib("3:.3") // penv stands for pitch envelope.. 
.pattack("0 .3 0.2 .1").release(0.8) // to hear the pitch release
.phaser(2).delay(.222).room(.333).size(3) // echo / phasing
.pcurve("<0 1>")

let shakeitoff = s("shaker_small*4").gain(perlin.range(1, 2))

let line = s("gm_fx_soundtrack").n("<5 2 1 3>").scale(tone).gain(0.5)
let robot = s("bot/2").delay(0.2).cutoff(1300).speed(1).phaser(2)
let chopper = s("gm_helicopter*2").fit()
let sparkles = n(run(12)).scale(tone).sound("gm_fx_echoes:1 gm_fx_echoes:2 gm_fx_echoes:3 gm_fx_echoes:4").delay(1).sometimesBy(0.5, x=>x.rev()).seg(4).gain(sine.range(0.2, 1))
  .room(0.4).phaser(2)

$: arrange(
  [intro, stack(line.gain(0.3).seg(8), shakeitoff, robot.mask(time.gt(1)), sparkles.gain(0.15).mask(time.gt(10)))], 
  [verse, stack(pulse, shakeitoff.seg(8), signals.gain(1.2), line, chopper)],
  [prec, stack(pulse.gain(1.3).beat("0,4,8,11,14",16), shakeitoff, signals)],
  [chorus, stack(line.gain(1.5).seg(8), sparkles.gain(0.4))]
)

$: s("lithuanian").sometimesBy(0.5, x=>x.rev()).gain(0.2).chop(1).speed(rand.range(0.85,1.1)).room(0.5).size(3).crush(perlin.range(4, 20))
  .delay(0.4).gain(0).clip(".5 1 2").scope()//.legato(5)






