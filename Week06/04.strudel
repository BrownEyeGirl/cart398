// annoying sounds that I hate 

// MAPPIN THE BEAT 
let intro = 8
let verse = 0
let prec = 0
let chorus = 0

let tone = "a:major"



// BD&HH
let pulse = s("bd").cutoff(500).room(0.8).roomsize(0.3).decay(0.5)

$: arrange(
  [intro, stack(pulse).seg(4)], 
  [verse, stack(pulse, s("hh*8"))],
  [prec, "~"],
  [chorus, "~"]
)

// STARS! 
let stars = wchooseCycles(["g5",1], ["c5",1], ["e5",2], ["f5",2]).fast(sine.range(8, 16)).note().s("gm_fx_echoes:1(6,16)")
  .seg(32).scale(tone).room(6).crush(4).legato(2)
  .tremsync(2).tremolophase("<0 .25 .66>")
$: sound("wt_digital_echoes(6, 16)").note("<f <g d> e c>").speed("<0.4 0.8 1.5 0.5 1.4>").scale(tone)

$: arrange(
  [intro, stars], 
  [verse, stack(s("bd*4"), s("hh*8"))],
  [prec, "~"],
  [chorus, "~"]
)